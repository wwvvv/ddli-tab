# Architecture-stage declarations; this directory is not a runnable app yet.
# Makers-documented AI Gateway variables. Server-only; never use VITE_* prefixes.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
AI_GATEWAY_MODEL=

# Draft DTab-owned configuration names; implementation will validate them.
DTAB_APP_ORIGIN=
DTAB_BLOB_NAMESPACE=dtab-native
DTAB_AUTH_SECRET=

# Defaults stay disabled until implementation, authorization and release gates pass.
# Merely changing these values is not sufficient to authorize live charging.
DTAB_PAYMENTS_ENABLED=false
DTAB_PAID_AI_ENABLED=false
