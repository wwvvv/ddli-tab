{
  "name": "ddli-tab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build-original.mjs",
    "build:web": "pnpm --filter @ddli/web run build",
    "dev:web": "pnpm --filter @ddli/web run dev",
    "typecheck:web": "pnpm --filter @ddli/web run typecheck",
    "dev": "pnpm run build && node scripts/serve-original.mjs",
    "preview": "node scripts/serve-original.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:os": "playwright test --config playwright.os.config.ts",
    "format:check": "prettier --check \"src/local/**/*.ts\" \"scripts/*.mjs\"",
    "test:db": "node scripts/test-database.mjs",
    "build:edge": "node scripts/build-original.mjs",
    "test:production": "node scripts/check-production.mjs",
    "build:extension": "node scripts/build-extension.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
